# ==========================================
# 1. Steering Files & Personal Overrides
# ==========================================
# Use these patterns to keep your local setups independent.
# Any file ending in .local or placed in the /scratch/ folder will be ignored.
*.local
*.local.*
*.override.*
/scratch/
/personal/
.env
.env.*.local

